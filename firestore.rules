rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public-facing profile data is kept separate so private user fields such as
    // email and login metadata never need to be exposed to other users.
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && (!request.resource.data.keys().hasAny(['photoURL'])
          || request.resource.data.photoURL == null
          || request.resource.data.photoURL is string);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Answers are private by default. Public answers are visible to signed-in users.
    match /answers/{answerId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.answer is string
        && request.resource.data.answer.size() >= 20
        && request.resource.data.isPublic is bool
        && request.resource.data.keys().hasOnly([
          'uid', 'date', 'question', 'category', 'answer', 'gems',
          'isPublic', 'createdAt'
        ]);

      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
          || resource.data.get('isPublic', false) == true);

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.answer is string
        && request.resource.data.answer.size() >= 20
        && request.resource.data.isPublic is bool
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['answer', 'isPublic', 'updatedAt']);

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
