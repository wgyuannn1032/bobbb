rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public answers are anonymous, so profile data is never readable by others.
    match /publicProfiles/{userId} {
      allow read, write: if false;
    }

    // Answers are private by default. Public answers are visible to signed-in users.
    match /answers/{answerId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && answerId == request.auth.uid + '_' + request.resource.data.date
          + '_' + request.resource.data.questionId
        && request.resource.data.answer is string
        && request.resource.data.answer.size() >= 20
        && request.resource.data.isPublic is bool
        && request.resource.data.keys().hasOnly([
          'uid', 'date', 'questionId', 'question', 'category', 'answer', 'gems',
          'isPublic', 'createdAt'
        ])
        && request.resource.data.questionId is string;

      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
          || resource.data.get('isPublic', false) == true);

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.answer is string
        && request.resource.data.answer.size() >= 20
        && request.resource.data.isPublic is bool
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['answer', 'isPublic', 'updatedAt']);

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // One mood check-in per user and date. The app uses {uid}_{YYYY-MM-DD}
    // as the document ID; legacy auto-ID records remain readable.
    match /moods/{moodId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && moodId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly([
          'uid', 'date', 'mood', 'note', 'createdAt'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.mood is int
        && request.resource.data.mood >= 1
        && request.resource.data.mood <= 5
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.createdAt == request.time;

      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.date == resource.data.date
        && request.resource.data.keys().hasOnly([
          'uid', 'date', 'mood', 'note', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.mood is int
        && request.resource.data.mood >= 1
        && request.resource.data.mood <= 5
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['mood', 'note', 'updatedAt']);

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
